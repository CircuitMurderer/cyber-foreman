#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
OUTPUT_DIR=${1:-"$PROJECT_DIR/release/build"}
case "$OUTPUT_DIR" in
  /*) ;;
  *) OUTPUT_DIR="$PROJECT_DIR/$OUTPUT_DIR" ;;
esac

mkdir -p "$OUTPUT_DIR/linux-amd64" "$OUTPUT_DIR/linux-arm64" "$OUTPUT_DIR/web"

cd "$PROJECT_DIR"
pnpm -C "$PROJECT_DIR/web" build

CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
  "$PROJECT_DIR/scripts/go" build -buildvcs=false -trimpath -ldflags='-s -w -buildid=' \
  -o "$OUTPUT_DIR/linux-amd64/foreman" ./cmd/foreman

CGO_ENABLED=0 GOOS=linux GOARCH=arm64 \
  "$PROJECT_DIR/scripts/go" build -buildvcs=false -trimpath -ldflags='-s -w -buildid=' \
  -o "$OUTPUT_DIR/linux-arm64/foreman" ./cmd/foreman

cp -R "$PROJECT_DIR/web/dist/." "$OUTPUT_DIR/web/"

SOURCE_REVISION=$(git -C "$PROJECT_DIR" rev-parse HEAD 2>/dev/null || echo unknown)
{
  echo "source_revision=$SOURCE_REVISION"
  echo "go_version=$("$PROJECT_DIR/scripts/go" version | awk '{print $3}')"
  echo "linux_amd64=CGO_ENABLED=0,trimpath,stripped"
  echo "linux_arm64=CGO_ENABLED=0,trimpath,stripped"
  echo "frontend=prebuilt_static_assets"
} > "$OUTPUT_DIR/BUILD_INFO.txt"

if command -v sha256sum >/dev/null 2>&1; then
  (cd "$OUTPUT_DIR" && sha256sum linux-amd64/foreman linux-arm64/foreman > SHA256SUMS)
elif command -v shasum >/dev/null 2>&1; then
  (cd "$OUTPUT_DIR" && shasum -a 256 linux-amd64/foreman linux-arm64/foreman > SHA256SUMS)
else
  echo "warning: neither sha256sum nor shasum is available; checksums were not generated" >&2
fi

echo "release artifacts written to $OUTPUT_DIR"
