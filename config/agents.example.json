{
  "agents": [
    {
      "name": "opencode",
      "driver": "acp",
      "command": "./scripts/opencode",
      "args": ["acp"],
      "version_args": ["--version"],
      "default_workspace": "/absolute/path/to/project",
      "default_model": "foreman-openai/deepseek-flash",
      "provider": {
        "format": "openai",
        "base_url": "https://api.deepseek.com",
        "api_key_env": "FOREMAN_AGENT_API_KEY_OPENAI"
      }
    },
    {
      "name": "grok",
      "driver": "acp",
      "command": "./scripts/grok",
      "args": ["--no-auto-update", "agent", "stdio"],
      "version_args": ["version"],
      "auth_methods": ["xai.api_key", "cached_token"],
      "auth_optional": true,
      "default_workspace": "/absolute/path/to/project",
      "default_model": "foreman-openai",
      "provider": {
        "format": "openai",
        "base_url": "https://api.deepseek.com",
        "api_key_env": "FOREMAN_AGENT_API_KEY_OPENAI"
      }
    },
    {
      "name": "codex",
      "driver": "codex-app-server",
      "command": "codex",
      "args": ["app-server"],
      "default_workspace": "/absolute/path/to/project",
      "default_model": "deepseek-flash",
      "provider": {
        "format": "openai",
        "wire_api": "chat-completions",
        "base_url": "https://api.deepseek.com",
        "api_key_env": "FOREMAN_AGENT_API_KEY_OPENAI"
      }
    }
  ],
  "security": {
    "workspace_roots": ["/absolute/path/to"],
    "command_allowlist": [
      ["./scripts/test"],
      ["go", "test"],
      ["pnpm", "check"]
    ],
    "api_token_env": "FOREMAN_API_TOKEN"
  },
  "supervisor": {
    "semantic_review": {
      "format": "openai",
      "base_url": "http://qwen.internal/v1",
      "api_key_env": "FOREMAN_SUPERVISOR_API_KEY",
      "model": "qwen3.8",
	  "timeout": "20s",
	  "tool_calling": true,
	  "allow_workspace_diff": false,
	  "allow_operator_attention": false
    }
  }
}
